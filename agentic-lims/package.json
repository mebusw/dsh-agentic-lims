{
  "name": "@local/agentic-lims",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agentic LIMS MVP for the DSH right sidebar: mock lab data, deterministic scheduling, agent tools",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "data/*",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "scripts/*"
  ],
  "dependencies": {
    "mongodb": "^6.21.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
